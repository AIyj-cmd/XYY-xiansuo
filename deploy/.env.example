# 复制为仓库外私有运行目录中的 .env 后填写。该文件必须保持 600 权限。
NODE_ENV=production

# 仅 PM2 模板读取的仓库外运行目录；不要使用仓库内路径。
XIANSUO_SERVER_DIR=
XIANSUO_ILINK_GATEWAY_DIR=

# 生产环境必须使用绝对路径，并纳入受控备份。
DB_PATH=

JWT_SECRET=

# 仅首次创建 admin 时使用；生产空数据库必须设置至少 12 位的密码。
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_NAME=管理员
ADMIN_INITIAL_PASSWORD=

# 多少天未跟进后进入公海，范围 1-365。
POOL_IDLE_DAYS=7

# 阶段三默认均关闭；只接受 true/false。
LEAD_POOL_CLAIM_ENABLED=false
NOTIFICATION_CAPTURE_ENABLED=false
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_MOCK_ENABLED=false
NOTIFICATION_SCHEDULER_ENABLED=false

# 实验性普通微信内部提醒；Secret 必须是仓库外的 0600 文件，不能直接填写 Secret 值。
OPENCLAW_CHANNEL_ENABLED=false
# Gateway 启动时一次性读取；必须为仓库外精确 0600 JSON 对象映射文件（键为规范正整数用户 ID），勿写入仓库。
OPENCLAW_RECIPIENT_MAP_FILE=
# OpenClaw 官方配置文件；父目录必须为仓库外 0700，文件必须为 0600 或更严。
OPENCLAW_CONFIG_PATH=
# 旧单接收人兼容配置，已废弃；映射文件存在时被忽略。
OPENCLAW_PILOT_USER_ID=
OPENCLAW_GATEWAY_URL=http://127.0.0.1:38115
OPENCLAW_GATEWAY_SECRET_FILE=
# 仅 xiansuo-ilink-gateway 使用，必须为仓库外 0700 目录。
ILINK_POC_STATE_DIR=
OPENCLAW_STATE_DIR=
ILINK_POC_LIVE_ENABLED=false
ILINK_OPENCLAW_BIN=openclaw
ILINK_OPENCLAW_CHANNEL=openclaw-weixin
ILINK_REQUEST_TIMEOUT_MS=30000
ILINK_SESSION_CHECK_TIMEOUT_MS=5000
# 必须与 Gateway 的 ILINK_REQUEST_TIMEOUT_MS 相同；Gateway 会从每个已签名请求再次核对。
OPENCLAW_GATEWAY_SEND_TIMEOUT_MS=30000
# 必须严格大于上述窗口加 5000ms；Gateway 同样在 Adapter 前强制核对。
OPENCLAW_GATEWAY_TIMEOUT_MS=40000
OPENCLAW_MAX_ATTEMPTS=2

# 生产环境前后端同源，通常留空即可。
CORS_ORIGINS=

# 阶段四：真实 Key 只能注入 xiansuo-ai-scheduler，绝不能注入 API、Worker 或 H5。
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_FOLLOW_UP_RECORDS=3
AI_MAX_CONCURRENCY=2
AI_DAILY_GLOBAL_LIMIT=200
AI_DAILY_USER_LIMIT=4
AI_AUDIT_RETENTION_DAYS=90
AI_RESULT_RETENTION_DAYS=7
AI_FALLBACK_ENABLED=true
AI_TIMEZONE=Asia/Shanghai
AI_SCHEDULED_FOLLOW_ENABLED=false
AI_SCHEDULED_FOLLOW_TIME=08:30
AI_DAILY_REPORT_ENABLED=false
AI_DAILY_REPORT_TIME=18:00
AI_WEEKLY_REPORT_ENABLED=false
AI_SCAN_RECIPIENT_LIMIT=100
AI_SCAN_DEADLINE_MS=300000
AI_PILOT_USER_IDS=
