# 复制为 /opt/xiansuo/.env 后填写。该文件必须保持 600 权限。
NODE_ENV=development

# 生产环境必须使用绝对路径，并纳入受控备份。
DB_PATH=

JWT_SECRET=

# 仅首次创建 admin 时使用；生产空数据库必须设置至少 12 位的密码。
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_NAME=管理员
ADMIN_INITIAL_PASSWORD=

# 多少天未跟进后进入公海，范围 1-365。
POOL_IDLE_DAYS=7

# 生产环境前后端同源，通常留空即可。
CORS_ORIGINS=
