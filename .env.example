NODE_ENV=development
DB_PATH=
JWT_SECRET=
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_NAME=管理员
ADMIN_INITIAL_PASSWORD=

# 阶段三开关：未设置均默认为 false；只能填写 true 或 false。
LEAD_POOL_CLAIM_ENABLED=false
NOTIFICATION_CAPTURE_ENABLED=false
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_MOCK_ENABLED=false
NOTIFICATION_SCHEDULER_ENABLED=false
# 实验性普通微信内部提醒：仅 notification-worker 读取 Secret 文件；API、AI Scheduler 和 H5 不读取微信会话或密钥。
OPENCLAW_CHANNEL_ENABLED=false
# Gateway 启动时一次性读取；必须为仓库外精确 0600 JSON 对象映射文件（键为规范正整数用户 ID），勿写入仓库。
OPENCLAW_RECIPIENT_MAP_FILE=
# 旧单接收人兼容配置，已废弃；映射文件存在时被忽略。
OPENCLAW_PILOT_USER_ID=
OPENCLAW_GATEWAY_URL=http://127.0.0.1:38115
OPENCLAW_GATEWAY_SECRET_FILE=
# 仅 Gateway 进程使用；其 state 目录必须仓库外且权限 0700。
ILINK_POC_STATE_DIR=
# 仅 Gateway 进程使用；官方 OpenClaw 会话状态目录，权限 0700。
OPENCLAW_STATE_DIR=
# 仅 Gateway 进程使用；配置父目录必须仓库外 0700，文件为 0600 或更严。
OPENCLAW_CONFIG_PATH=
# Gateway 的完整发送窗口声明，必须与 Gateway 的 ILINK_REQUEST_TIMEOUT_MS 相同。
OPENCLAW_GATEWAY_SEND_TIMEOUT_MS=30000
# Worker HTTP 等待窗口；必须严格大于完整发送窗口加 5000ms 缓冲。
OPENCLAW_GATEWAY_TIMEOUT_MS=40000
OPENCLAW_MAX_ATTEMPTS=2
# 前端构建期开关，仅控制公海 UI，后端仍为安全事实源。
VITE_LEAD_POOL_CLAIM_ENABLED=false

# 阶段四：仅独立 AI Scheduler 读取。默认不会扫描、请求 Provider 或创建 AI 通知。
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_FOLLOW_UP_RECORDS=3
AI_MAX_CONCURRENCY=2
AI_DAILY_GLOBAL_LIMIT=200
AI_DAILY_USER_LIMIT=4
AI_AUDIT_RETENTION_DAYS=90
AI_RESULT_RETENTION_DAYS=7
AI_FALLBACK_ENABLED=true
AI_TIMEZONE=Asia/Shanghai
AI_SCHEDULED_FOLLOW_ENABLED=false
AI_SCHEDULED_FOLLOW_TIME=08:30
AI_DAILY_REPORT_ENABLED=false
AI_DAILY_REPORT_TIME=18:00
AI_WEEKLY_REPORT_ENABLED=false
AI_SCAN_RECIPIENT_LIMIT=100
AI_SCAN_DEADLINE_MS=300000
AI_PILOT_USER_IDS=
