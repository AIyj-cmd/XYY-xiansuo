{
  "name": "xiansuo-ilink-poc-gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "normalize:runtime-launchers": "node scripts/normalize-runtime-launchers.mjs",
    "build": "npm run normalize:runtime-launchers && tsc -p tsconfig.json",
    "test": "npm run normalize:runtime-launchers && tsx --test test/*.test.ts",
    "prestart": "npm run normalize:runtime-launchers",
    "start": "tsx src/server.ts",
    "gateway:health": "tsx src/cli/health.ts",
    "gateway:recipient-map-check": "node dist/cli/recipient-map-check.js",
    "gateway:session-status": "tsx src/cli/session-status.ts",
    "gateway:prereq-check": "tsx src/cli/prereq-check.ts",
    "gateway:official-session-status": "tsx src/cli/official-session-status.ts",
    "gateway:login": "tsx src/cli/login.ts",
    "gateway:send-synthetic": "tsx src/cli/send-synthetic.ts",
    "gateway:pilot-control": "tsx src/cli/pilot-control.ts"
  },
  "dependencies": { "zod": "^4.4.3" },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
