# 仅限隔离 PoC；实际配置必须位于仓库外且权限为 600。
ILINK_GATEWAY_HOST=127.0.0.1
ILINK_GATEWAY_PORT=38115
ILINK_POC_STATE_DIR=
# OpenClaw 官方会话状态目录；live 模式必须配置，目录权限 0700。
OPENCLAW_STATE_DIR=
# 必须是仓库外、已存在且权限 0700 的目录中的配置文件；文件若存在须为 0600 或更严。
OPENCLAW_CONFIG_PATH=
# 仓库外、权限 0600 的普通文件；Gateway 与 notification-worker 使用同一个文件。
ILINK_GATEWAY_SECRET_FILE=
# 仓库外、精确 0600 的静态 JSON 对象；键为规范正整数系统用户 ID，值含 target 与 enabled。发布冻结时 live 模式必须恰好一个 enabled=true；其他预配置项保持 enabled=false。
OPENCLAW_RECIPIENT_MAP_FILE=
# 兼容旧单接收人模式，已废弃；未设置映射文件时两项必须同时设置。
OPENCLAW_PILOT_USER_ID=
ILINK_POC_LIVE_ENABLED=false
ILINK_OPENCLAW_BIN=openclaw
ILINK_OPENCLAW_CHANNEL=openclaw-weixin
ILINK_POC_RECIPIENT_EXTERNAL_ID=
# Gateway 完整出站窗口（Adapter Abort 与 OpenClaw CLI 进程超时共用）；需与业务端 OPENCLAW_GATEWAY_SEND_TIMEOUT_MS 一致。
ILINK_REQUEST_TIMEOUT_MS=30000
ILINK_SESSION_CHECK_TIMEOUT_MS=5000
